# Copy to .env and fill in. `.env` is gitignored and must stay that way --
# the GitHub repository is PUBLIC.

# REQUIRED. The pipeline aborts without it: config.REQUIRE_PROVIDER is set to
# "polygon", so it will not silently fall back to another source. (An earlier
# version of this file said no key was needed and Yahoo would be used instead --
# that stopped being true when Yahoo was removed from the provider chain.)
POLYGON_API_KEY=

# Optional. Live ETF holdings, for more accurate breadth. Without it the code
# uses the static constituent lists in smf/config.py.
FMP_API_KEY=

# Optional. Slack/Discord-compatible webhook for phase alerts (run.py --alert).
SMF_WEBHOOK_URL=

# Optional. Minimum seconds between browser-triggered live fetches.
# 0 = no limit, which is correct for an unmetered Polygon plan.
SMF_FETCH_COOLDOWN_SEC=0
